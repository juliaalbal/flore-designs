# ============================================================
#  FloreDesigns - Variables de entorno
#  Archivo: .env
#
#  IMPORTANTE: Este archivo NUNCA debe subirse a GitHub.
#  Ya está incluido en .gitignore.
#
#  En producción, configura estas variables en el panel de tu
#  hosting, NO en este archivo.
# ============================================================

# Base de datos (ajusta a tu XAMPP/MySQL local)
DB_HOST=localhost
DB_NAME=floredesigns
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Correo (Gmail SMTP) - RF-06
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_contrasena_de_app
MAIL_FROM=tu_correo@gmail.com
MAIL_FROM_NAME=Floré Designs

# Entorno: development | production
APP_ENV=development
APP_URL=http://localhost

# OpenWeatherMap - pronóstico del clima para la fecha de la cita en citas.html
# Regístrate gratis en https://openweathermap.org/api (solo pide correo,
# NO pide tarjeta para la capa gratuita clásica: /data/2.5/forecast).
# La key puede tardar unos minutos en activarse después de crearla.
OPENWEATHER_API_KEY=
