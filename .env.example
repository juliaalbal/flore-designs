# ============================================================
#  FloreDesigns - Variables de entorno
#  Archivo: .env
#
#  IMPORTANTE: Este archivo NUNCA debe subirse a GitHub.
#  Ya está incluido en .gitignore.
#
#  En producción, configura estas variables en el panel de tu
#  hosting, NO en este archivo.
# ============================================================

# Base de datos (ajusta el puerto/usuario a tu XAMPP/MySQL local)
DB_HOST=localhost:3306
DB_NAME=floredesigns
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Correo (Gmail SMTP) - RF-06
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_contrasena_de_app
MAIL_FROM=tu_correo@gmail.com
MAIL_FROM_NAME=Floré Designs

# Entorno: development | production
APP_ENV=development
APP_URL=http://localhost

# Google Maps (Maps JavaScript API) - ubicación del atelier en citas.html
# Consíguela en https://console.cloud.google.com/google/maps-apis
# IMPORTANTE: restringe esta key por "HTTP referrers" a tu propio dominio,
# ya que se usa del lado del navegador (esa es la protección real, no ocultarla).
MAPS_API_KEY=
